{
  "output": "eDP-1",
  "layer": "top",
  "position": "top",
  "height": 23,
  "spacing": 3,
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": [
    "custom/archicon",
    "custom/wattage",
    "clock",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "custom/custom1",
    "custom/custom2"
  ],
  "modules-right": [
    "wlr/taskbar",
    "idle_inhibitor",
    "battery",
    "pulseaudio/slider",
    "pulseaudio",
    "network",
    "custom/power",
    "tray"
  ],
  "custom/archicon": {
    "format": ".",
    "on-click": "fuzzel --hide-prompt --minimal-lines",
    "tooltip": false
  },
  "custom/wattage": {
    "exec": "paste /sys/class/power_supply/BAT1/voltage_now /sys/class/power_supply/BAT1/current_now | awk '{printf \"✝ %.2fW\", ($1 * $2) / 1e12}'",
    "interval": 1,
    "format": "{}"
},
  "clock": {
    "timezone": "America/Los_Angeles",
    "format": "{:%I:%M - %m/%d/%y}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month"
    }
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%\nCores: {cores}"
  },
  "memory": {
    "format": "{}% 󰍛",
    "tooltip": true,
    "tooltip-format": "RAM in use: {used} / {total} ({percentage}%)"
  },
  "disk": {
    "format": "{percentage_free}% ",
    "tooltip": true,
    "tooltip-format": "Free Space: {free} / {total} ({percentage_free}%)"
  },
  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "tooltip": true,
    "tooltip-format": "Current Temp: {temperatureC}°C\nCritical if > 80°C",
    "format-icons": [""]
  },
  "custom/custom1": {
    "format": "CardWire",
    "on-click": "pgrep -x cardwire-gui >/dev/null || cardwire-gui &",
    "tooltip-format": "Cardwire"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": true,
    "active-first": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["xwaylandvideobridge"],
    "icon-theme": "Papirus-Dark",
    "app_ids-mapping": {
      "thorium-browser": "thorium-browser",
      "thorium": "thorium-browser"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "pulseaudio/slider": {
    "format": "{volume}%",
    "format-muted": " ",
    "step": 5,
    "tooltip": false
  },
  "pulseaudio": {
    "on-click": "pavucontrol",
    "format": "{volume}% {icon}",
    "format-muted": " {format_source}",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "network": {
    "format-wifi": "     {essid}",
    "format-ethernet": "  {ifname}",
    "format-disconnected": " ",
    "tooltip-format": " {ifname} via {gwaddr}",
    "on-click": "gnome-terminal --title=\"nmtui-terminal\" --geometry=50x20 -- sudo nmtui",
    "max-length": 43
  },
  "custom/power": {
    "format": "",
    "on-click": "wlogout",
    "tooltip": false
  },
  "battery": {
    "bat": "BAT1",
    "states": {
      "warning": 50,
      "critical": 25
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true
  },
  "tray": {
    "icon-size": 12,
    "spacing": 9
  }
}
