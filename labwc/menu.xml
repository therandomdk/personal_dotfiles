<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>

<menu id="client-menu">
  <item label="Minimize">
    <action name="Iconify" />
  </item>
  <item label="Maximize">
    <action name="ToggleMaximize" />
  </item>
  <item label="Close">
    <action name="Close" />
  </item>
</menu>

<menu id="root-menu">
  <item label="Terminal">
    <action name="Execute" command="gnome-terminal" />
  </item>
  <item label="Thorium">
    <action name="Execute" command="thorium-browser" />
  </item>
  <separator />
  <item label="System Update">
    <action name="Execute" command="gnome-terminal -- bash -c 'sudo dnf upgrade -y; exec bash'" />
  </item>
  <item label="Clean Packages">
    <action name="Execute" command="gnome-terminal -- bash -c 'sudo dnf autoremove -y; exec bash'" />
  </item>
  <separator />
  <item label="Reconfigure">
    <action name="Reconfigure" />
  </item>
  <item label="Session">
    <action name="Execute" command="wlogout" />
  </item>
</menu>

</openbox_menu>