# 1. Export Environment Variables
export XDG_CURRENT_DESKTOP=wlroots
export SCREENSHOT_PORTAL=wlr
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export WLR_DRM_DEVICES="/dev/dri/by-path/pci-0000:00:02.0-card"

# 2. Sync to Systemd and DBus
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    SCREENSHOT_PORTAL \
    MOZ_ENABLE_WAYLAND \
    QT_QPA_PLATFORM \
    SDL_VIDEODRIVER

# 3. Reset Portals
# Stops existing instances to prevent conflicts before re-launching
systemctl --user stop xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk 2>/dev/null
/usr/libexec/xdg-desktop-portal-wlr -r &
/usr/libexec/xdg-desktop-portal-gtk -r &
/usr/libexec/xdg-desktop-portal -r &

# 4. Launch Core UI Services
pkill -f nm-applet
sleep 2 && waybar &
~/.azotebg &

# 5. Launch Background Services
xsettingsd &
swaync &
blueman-applet &
nm-applet &

# 6. Hardware and Xwayland
brightnessctl set 70% &
xwaylandvideobridge &
sleep 1 && wtype -M logo -k 1 -m logo
wlr-randr --output HDMI-A-2 --left-of eDP-1 &
cardwire-gui &


